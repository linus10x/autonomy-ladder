{
	"name": "autonomy-ladder",
	// Worker handles /api/leads; ASSETS serves the static site.
	"main": "workers/leads.js",
	"compatibility_date": "2026-09-29",
	"assets": {
		"directory": ".",
		"binding": "ASSETS",
		// Canonicals are unslashed (/assessment, /services, /whitepaper).
		// auto-trailing-slash would 307 /assessment to /assessment/ instead of returning 200.
		"html_handling": "drop-trailing-slash"
	},
	"kv_namespaces": [
		{
			"binding": "LEADS",
			"id": "d865bc977c5d46439401fc8e69bde289"
		}
	],
	// Internal lead-notify Worker (desk-ops systems/lead-notify). Autonomy
	// Ladder leads go to the owner's personal Gmail (owner decision 2026-11-09).
	"services": [
		{ "binding": "LEAD_NOTIFY", "service": "lead-notify" }
	]
}
