{
	"name": "autonomy-ladder",
	// Assets only. No Worker script, so no "main" and no assets.binding.
	// compatibility_date is the date this config was added.
	"compatibility_date": "2026-09-29",
	"assets": {
		"directory": ".",
		// Canonicals are unslashed (/assess, /diagnostic, /services, /whitepaper).
		// auto-trailing-slash would 307 /assess to /assess/ instead of returning 200.
		"html_handling": "drop-trailing-slash"
	}
}
